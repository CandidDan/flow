{
  "name": "flow-canonical",
  "private": true,
  "description": "Canonical Flow: the protocol, the reusable workflows, and the .flow/bin tooling consuming repos adopt by reference. This manifest exists to give canonical its own gate — it is not a published package.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node .flow/bin/check-workflows.mjs",
    "lint": "node .flow/bin/check-syntax.mjs",
    "test": "node --test \".flow/bin/*.test.mjs\" \"project-template/.flow/bin/*.test.mjs\" \"flightdeck/bin/*.test.mjs\"",
    "coverage": "c8 npm test"
  },
  "c8": {
    "all": true,
    "include": [
      ".flow/bin/**/*.mjs",
      "project-template/.flow/bin/**/*.mjs",
      "flightdeck/bin/**/*.mjs"
    ],
    "exclude": [
      "**/*.test.mjs"
    ],
    "reporter": [
      "text-summary"
    ],
    "temp-directory": "node_modules/.cache/flow-c8/tmp",
    "report-dir": "node_modules/.cache/flow-c8/report",
    "check-coverage": true,
    "lines": 83.5
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "yaml": "^2.8.1"
  }
}
