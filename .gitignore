# CandidDan/flow — canonical Flow infrastructure (template, flightdeck, docs, + reusable
# workflows and the bin package as they land). Nested repos and local artifacts are excluded.

# Nested repos that are their own distributables — NOT part of canonical:
flow-plugin/        # CandidDan/flow-plugin — the marketplace, versioned separately
flow-validation/    # the throwaway CI-validation repo

# Local artifacts / junk
mnt/
.DS_Store
**/.DS_Store

# Node (for the forthcoming bin package)
node_modules/
*.tsbuildinfo
npm-debug.log*

# Flow board-edits scratch (never committed)
**/.flow/board-edits.json

# flow-review.mjs's scratch output (the bounded diff + changed-files list it hands the reviewers) —
# CI always starts from a fresh checkout so it never sees this, but `npm test` runs the real CLI
# against this repo's own root and leaves it behind locally.
.flow-review/

# --- kept local: private registry, business scaffolding, Cowork mount ---
flightdeck/projects.yml
NUDGE-RETROFIT-NOTES.md
nudge-migration/
flow-validation/
flow-plugin/
flow-release.sh
flow-publish.sh

# --- kept local, never published ---
_private/
flow-catchup.sh
